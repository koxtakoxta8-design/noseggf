-- STEAL AN EGG - MECANICA EXTRAIDA
--
-- Este bloque esta hecho para ejecutarse DESPUES de cargar el script original.
-- Usa las mismas funciones internas del archivo original:
--   v67.OpenWindow()  -> prepara la ventana de TP usando el huevo de paso
--   v60.Best()        -> selecciona el mejor huevo con el mismo ranking
--   v67.Blink()       -> hace el mismo TP del sistema original
--
-- No inicia el Auto Farm, no entrega el huevo y no repite ciclos.
-- La secuencia es: preparar la mecanica -> buscar mejor huevo -> TP al mejor huevo.

local function Koxta_SoloTPAlMejorHuevo()
    -- 1) Abre la misma ventana que utiliza el script original.
    -- Esta parte es la mecanica que permite hacer el TP especial.
    local okWindow, errWindow = pcall(function()
        return v67.OpenWindow()
    end)

    if not okWindow then
        warn('[STEAL AN EGG] Error abriendo ventana:', errWindow)
        return false
    end

    if errWindow ~= true then
        warn('[STEAL AN EGG] No se pudo abrir la ventana:', errWindow)
        return false
    end

    -- 2) Busca el mejor huevo usando EXACTAMENTE el selector del script.
    local target = v60.Best()

    if not target or not target.rec or not target.rec.BottomCFrame then
        warn('[STEAL AN EGG] No encontre un mejor huevo disponible.')
        pcall(v67.CloseWindow)
        return false
    end

    local position = target.rec.BottomCFrame.Position

    -- 3) TP al mejor huevo con el mismo Blink del script original.
    local okBlink, blinkResult = pcall(function()
        return v67.Blink(Vector3.new(
            position.X,
            position.Y + 3,
            position.Z
        ))
    end)

    if not okBlink or not blinkResult then
        warn('[STEAL AN EGG] El TP al mejor huevo fallo:', blinkResult)
        pcall(v67.CloseWindow)
        return false
    end

    print('[STEAL AN EGG] TP realizado al mejor huevo:', target.rec.AssetCategory)
    return true
end

-- Ejecutar una sola vez:
Koxta_SoloTPAlMejorHuevo()
