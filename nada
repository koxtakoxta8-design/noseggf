-- SOLO: PEOR HUEVO -> MEJOR HUEVO -> PARAR
-- Basado en la mecanica encontrada en el archivo original.
--
-- IMPORTANTE:
-- Este bloque usa las funciones internas que ya existen en el script original:
--   v67.OpenWindow()
--   v60.Ranked()
--   v60.Best()
--   v67.Blink()
--
-- NO inicia AutoFarm, NO hace ciclos y NO continua despues del TP.
--
-- La parte de "peor" usa el ultimo candidato valido devuelto por Ranked(15).
-- Esto presupone que Ranked() devuelve los candidatos en el mismo orden
-- descendente que utiliza Best(). Si el juego cambia ese orden, el peor
-- debera determinarse desde la funcion interna de ranking.

local function Koxta_SoloPeorAlMejor()

    --==================================================
    -- 1) PREPARAR LA MECANICA ORIGINAL
    --==================================================

    local okWindow, windowResult = pcall(function()
        return v67.OpenWindow()
    end)

    if not okWindow or windowResult ~= true then
        warn("[SOLO TP] No se pudo abrir la ventana")
        return false
    end

    --==================================================
    -- 2) OBTENER LOS HUEVOS DISPONIBLES
    --==================================================

    local okRanked, ranked = pcall(function()
        return v60.Ranked(15)
    end)

    if not okRanked or type(ranked) ~= "table" then
        warn("[SOLO TP] No se pudo obtener el ranking de huevos")
        pcall(v67.CloseWindow)
        return false
    end

    --==================================================
    -- 3) BUSCAR EL PEOR HUEVO
    --==================================================

    local worst

    -- Ranked() se recorre completo y se conserva el ultimo
    -- candidato valido.
    for _, candidate in ipairs(ranked) do

        local rec = candidate and candidate.rec

        if rec
            and rec.BottomCFrame
            and rec.CarrierUserId == nil then

            worst = candidate
        end
    end

    if not worst or not worst.rec or not worst.rec.BottomCFrame then
        warn("[SOLO TP] No se encontro un huevo valido")
        pcall(v67.CloseWindow)
        return false
    end

    --==================================================
    -- 4) OBTENER EL MEJOR HUEVO
    --==================================================

    local okBest, best = pcall(function()
        return v60.Best()
    end)

    if not okBest
        or not best
        or not best.rec
        or not best.rec.BottomCFrame then

        warn("[SOLO TP] No se encontro el mejor huevo")
        pcall(v67.CloseWindow)
        return false
    end

    -- Evitar que peor y mejor sean el mismo huevo cuando solo
    -- existe un candidato.
    if worst.rec.Uid and best.rec.Uid
        and worst.rec.Uid == best.rec.Uid then

        warn("[SOLO TP] Solo hay un huevo disponible")
        pcall(v67.CloseWindow)
        return false
    end

    --==================================================
    -- 5) POSICION DEL PEOR HUEVO
    --==================================================

    local worstPosition = worst.rec.BottomCFrame.Position

    --==================================================
    -- 6) IR AL PEOR HUEVO
    --==================================================

    local okWorstTP, worstTP = pcall(function()
        return v67.Blink(Vector3.new(
            worstPosition.X,
            worstPosition.Y + 3,
            worstPosition.Z
        ))
    end)

    if not okWorstTP or not worstTP then
        warn("[SOLO TP] Fallo el TP al peor huevo")
        pcall(v67.CloseWindow)
        return false
    end

    --==================================================
    -- 7) POSICION DEL MEJOR HUEVO
    --==================================================

    local bestPosition = best.rec.BottomCFrame.Position

    --==================================================
    -- 8) TP DEL PEOR -> MEJOR
    --==================================================

    local okBestTP, bestTP = pcall(function()
        return v67.Blink(Vector3.new(
            bestPosition.X,
            bestPosition.Y + 3,
            bestPosition.Z
        ))
    end)

    if not okBestTP or not bestTP then
        warn("[SOLO TP] Fallo el TP al mejor huevo")
        pcall(v67.CloseWindow)
        return false
    end

    --==================================================
    -- 9) TERMINAR COMPLETAMENTE
    --==================================================

    print("[SOLO TP] Peor -> Mejor completado. FIN.")
    return true
end

-- EJECUTAR UNA SOLA VEZ
Koxta_SoloPeorAlMejor()
