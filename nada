-- STEAL AN EGG - MECANICA: POLLO/TICKET -> MEJOR HUEVO
--
-- IMPORTANTE:
-- Este fragmento NO es un script independiente.
-- Pegalo AL FINAL del script original, donde v60 y v67 siguen en alcance.
--
-- Secuencia exacta basada en la mecanica del archivo:
-- 1) v67.OpenWindow() encuentra y carga el huevo de paso/primera area (ticket, el "pollo").
-- 2) La funcion original abre la ventana mediante ForestStrike/ragdoll.
-- 3) v60.Best() obtiene el mejor huevo segun el ranking original.
-- 4) v67.Blink() hace TP al mejor huevo.
-- 5) Se detiene ahi. NO hace Auto Farm ni entrega ni repite.

local function POLLO_A_MEJOR()
    -- Paso 1: agarrar el huevo de paso (ticket/pollo) y abrir la ventana.
    local okWindow, errWindow = pcall(v67.OpenWindow)
    if not okWindow or not errWindow then
        warn("[POLLO->MEJOR] No se pudo abrir la ventana: " .. tostring(errWindow))
        return false
    end

    task.wait(0.05)

    -- Paso 2: seleccionar el mejor huevo con EL MISMO ranking del script.
    local okBest, best = pcall(v60.Best)
    if not okBest or type(best) ~= "table" or not best.rec then
        pcall(v67.CloseWindow)
        warn("[POLLO->MEJOR] No se encontro el mejor huevo")
        return false
    end

    local rec = best.rec
    if not rec.BottomCFrame then
        pcall(v67.CloseWindow)
        warn("[POLLO->MEJOR] El mejor huevo no tiene BottomCFrame")
        return false
    end

    -- Paso 3: TP al mejor huevo usando EL MISMO Blink del script.
    local pos = rec.BottomCFrame.Position
    local okBlink, blinkResult = pcall(function()
        return v67.Blink(Vector3.new(pos.X, pos.Y + 3, pos.Z))
    end)

    if not okBlink or not blinkResult then
        pcall(v67.CloseWindow)
        warn("[POLLO->MEJOR] Fallo el TP: " .. tostring(blinkResult))
        return false
    end

    print("[POLLO->MEJOR] TP realizado al mejor huevo: " .. tostring(best.info and best.info.name or rec.AssetCategory))
    return true
end

-- BOTON PARA ACTIVAR LA MECANICA
local Players = game:GetService("Players")
local player = Players.LocalPlayer
local gui = Instance.new("ScreenGui")
gui.Name = "POLLO_A_MEJOR_GUI"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local button = Instance.new("TextButton")
button.Size = UDim2.fromOffset(210, 48)
button.Position = UDim2.new(0.5, -105, 0.75, 0)
button.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
button.TextColor3 = Color3.fromRGB(255, 255, 255)
button.Text = "🐔 POLLO -> MEJOR HUEVO"
button.TextSize = 14
button.Font = Enum.Font.GothamBold
button.BorderSizePixel = 0
button.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 10)
corner.Parent = button

local busy = false
button.MouseButton1Click:Connect(function()
    if busy then return end
    busy = true
    button.Text = "BUSCANDO..."

    local ok = POLLO_A_MEJOR()

    button.Text = ok and "✓ TP HECHO" or "✕ INTENTAR DE NUEVO"
    task.wait(1.2)
    button.Text = "🐔 POLLO -> MEJOR HUEVO"
    busy = false
end)
